    {
      "page_id": "c07",
      "index": 7,
      "width": 2200,
      "height": 2025,
      "official_label": "pp. [10]-[11]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/07855068-9f44-4ce8-8494-fc635975ffd0.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/07855068-9f44-4ce8-8494-fc635975ffd0/full/2200,/0/default.jpg",
      "source_sha256": "afe199a17aa9fafa8c07b405238a3c46dd043e6612cd654bb26840b5fb878ca6",
      "layout_note": "右、左兩面連續醫學正文，左面有價格與服次小註。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "complete"
      },
      "units": [
        {
          "id": "c07-u01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "土人習而不察、故以爲擺子、往來無定、歸",
          "bbox": null
        },
        {
          "id": "c07-u02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "咎於醫藥寡効、及戒口不淸耳、茲特將醫",
          "bbox": null
        },
        {
          "id": "c07-u03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "藥治法、詳晰並錄、俾知醫有妙藥、治有定",
          "bbox": null
        },
        {
          "id": "c07-u04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "法、而着手生春焉、並附金雞納霜信石酒",
          "bbox": null
        },
        {
          "id": "c07-u05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "製法於後、",
          "bbox": null
        },
        {
          "id": "c07-u06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "金雞納霜、出自南亞美利駕、樹名金雞納",
          "bbox": null
        },
        {
          "id": "c07-u07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "霜、乃其樹皮所出、西國藥肆、用價沽此",
          "bbox": null
        },
        {
          "id": "c07-u08",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "樹皮、昔時多是研末作散、或用煎湯、近",
          "bbox": null
        },
        {
          "id": "c07-u09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "則多方泡製、得其樹皮之精漿、故名曰",
          "bbox": null
        },
        {
          "id": "c07-u10",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "霜、其價頗昂、現年比前數年、價平一半、",
          "bbox": null
        },
        {
          "id": "c07-u11",
          "layer": "original-print",
          "role": "note",
          "side": "left",
          "text": "四大約換三",
          "bbox": null
        },
        {
          "id": "c07-u12",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "其性不寒不熱、色白、味苦、功力",
          "bbox": null
        },
        {
          "id": "c07-u13",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "全補、是治擺子第一妙藥也、平常發熱、",
          "bbox": null
        },
        {
          "id": "c07-u14",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "卽潮熱、於每日熱退時、服一二分、",
          "bbox": null
        },
        {
          "id": "c07-u15",
          "layer": "original-print",
          "role": "note",
          "side": "left",
          "text": "兩次",
          "bbox": null
        },
        {
          "id": "c07-u16",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "極有應驗、又凡人不論甚麼病、後欠補、",
          "bbox": null
        },
        {
          "id": "c07-u17",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "及戒洋烟後、欠補、朝晚飯前、每服二厘、",
          "bbox": null
        },
        {
          "id": "c07-u18",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "可補元氣、戒洋烟藥丸斷不可少此一",
          "bbox": null
        },
        {
          "id": "c07-u19",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "味、河南鰲洲興盛行常有發兌、每樽",
          "bbox": null
        },
        {
          "id": "c07-u20",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "約八錢、價銀二員半、如買十樽、價銀二",
          "bbox": null
        }
      ],
      "uncertainties": [
        {
          "id": "c07-unc-01",
          "unit_id": "c07-u11",
