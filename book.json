    {
      "page_id": "c03",
      "index": 3,
      "width": 2200,
      "height": 2025,
      "official_label": "pp. [2]-[3]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/d1e8b916-8bb7-4574-aeb5-50094cafa5ae.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/d1e8b916-8bb7-4574-aeb5-50094cafa5ae/full/2200,/0/default.jpg",
      "source_sha256": "27a4730db820095c44c51b3dd0241a803101c9b5b07bc936db00d55d8db1f961",
      "layout_note": "右面為扉頁背面透印及藏章，不重複錄透印；左面宗教前言起首，右側近裝訂處有局部印墨與遮邊。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "complete"
      },
      "units": [
        {
          "id": "c03-L01",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "嘗思天道福善禍淫、疾病死亡、所以報惡",
          "bbox": null
        },
        {
          "id": "c03-L02",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "者也、初天地闢時、亞當夏娃二人違",
          "bbox": null
        },
        {
          "id": "c03-L03",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "天父命、食禁果、罪惡由此始、厥後苗裔因",
          "bbox": null
        },
        {
          "id": "c03-L04",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "有罪惡、既有罪惡、當受懲罰、　　天父特",
          "bbox": null
        },
        {
          "id": "c03-L05",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "降以死亡、疾病、懲惡罰罪、使人悔改、此意、",
          "bbox": null
        },
        {
          "id": "c03-L06",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "非無足據、昔保羅曰、且以一人在世有罪、",
          "bbox": null
        },
        {
          "id": "c03-L07",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "因罪而死、又曰、罪惡之償値、乃死、蓋禍難",
          "bbox": null
        },
        {
          "id": "c03-L08",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "由於罪惡、然罪惡之報、不徒在於今生、更",
          "bbox": null
        },
        {
          "id": "c03-L09",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "在於世界末日、故見人有禍難、在己貴以",
          "bbox": null
        }
      ],
      "uncertainties": [
        {
          "id": "c03-unc-01",
          "unit_id": "c03-L07",
          "start": 0,
          "end": 20,
          "surface": "因罪而死、又曰、罪惡之償値、乃死、蓋禍難",
          "extent": "located-unit",
          "cause": "reading-unresolved",
          "candidates": [
            "乃",
            "亡"
          ],
          "reason": "字形起筆為横折彎撇，無上橫點，筆勢作木刻'乃'字；文意對應新約聖經羅馬書6:23（罪惡之償値乃死/工價乃是死），與本頁第1欄'死亡'之'亡'字（起筆有清晰橫點）形體顯異。",
          "position_note": "初錄疑讀以整個定位單位標記，未聲稱精確到單字；候選可能只涉及該欄內部分文字。"
        },
