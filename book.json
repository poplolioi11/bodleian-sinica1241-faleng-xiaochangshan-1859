    {
      "page_id": "c06",
      "index": 6,
      "width": 2200,
      "height": 2025,
      "official_label": "pp. [8]-[9]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/64ab54b0-ee9f-4865-b17f-b0728d90030a.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/64ab54b0-ee9f-4865-b17f-b0728d90030a/full/2200,/0/default.jpg",
      "source_sha256": "1d111994bd872b749eb23eee435be3b87bfd1edd229062781943cfac868fed0a",
      "layout_note": "右、左兩面連續醫學正文，含服量與頻次；版心分列。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "complete"
      },
      "units": [
        {
          "id": "c06-R01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "預先五點鐘、每點鐘服一次、倘服了三次",
          "bbox": null
        },
        {
          "id": "c06-R02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "病或速作、不必服第四次、因病未作則可",
          "bbox": null
        },
        {
          "id": "c06-R03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "截、病旣作則不可截、或病者身體太弱、恐",
          "bbox": null
        },
        {
          "id": "c06-R04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "或隨服隨嘔、宜每次服三厘、照期分兩日",
          "bbox": null
        },
        {
          "id": "c06-R05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "服、旣截後、凡每日一作者、自病截日起、計",
          "bbox": null
        },
        {
          "id": "c06-R06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "至第七日、恐或復發、是日宜預早服此藥",
          "bbox": null
        },
        {
          "id": "c06-R07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "三四次、每次比前少些、自此服藥日起、又",
          "bbox": null
        },
        {
          "id": "c06-R08",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "計至七日、仍恐復發、照式服藥、直計至第",
          "bbox": null
        },
        {
          "id": "c06-R09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "三四次之七日、仍須服藥、其間一日作者、",
          "bbox": null
        },
        {
          "id": "c06-L01",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "自病截前一日起計、每至十四日或復發",
          "bbox": null
        },
        {
          "id": "c06-L02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "仍照式服藥以截之、又法、服信石酒一錢、",
          "bbox": null
        },
        {
          "id": "c06-L03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "至一錢半、須於朝晨、及作冷前、每服一次、",
          "bbox": null
        },
        {
          "id": "c06-L04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "亦可截、截後恐或復發、仍計七日之期以",
          "bbox": null
        },
        {
          "id": "c06-L05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "截之、此二法、屢試屢驗、但截後覺口苦頭",
          "bbox": null
        },
        {
          "id": "c06-L06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "疼、及各般身體不安、宜服輕瀉藥以鬆之、",
          "bbox": null
        },
        {
          "id": "c06-L07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "自然全愈、此種瘧症、常有定期、西國人多",
          "bbox": null
        },
        {
          "id": "c06-L08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "患此症、屢經細察、故知如此、愚見中土人",
          "bbox": null
        },
        {
          "id": "c06-L09",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "患此症者、亦覺愈後復發、恰照定期、特中",
          "bbox": null
        },
        {
          "id": "c06-L-folio",
          "layer": "original-print",
          "role": "folio",
          "side": "left",
          "text": "二",
          "bbox": null
        }
      ],
      "uncertainties": [
        {
          "id": "c06-unc-01",
          "unit_id": "c06-L06",
          "start": 0,
