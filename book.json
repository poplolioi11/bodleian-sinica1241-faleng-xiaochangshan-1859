      "units": [
        {
          "id": "c03-L01",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "嘗□天道福善禍淫、疾病死亡、所以報惡",
          "bbox": null
        },
        {
          "id": "c03-L02",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "者也、初、天地闢時、亞當夏娃二人違",
          "bbox": null
        },
        {
          "id": "c03-L03",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "天父命、食禁果、罪惡由此始、厥後苗裔、因",
          "bbox": null
        },
        {
          "id": "c03-L04",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "有罪惡、既有罪惡、當受懲罰、　　天父特",
          "bbox": null
        },
        {
          "id": "c03-L05",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "降以死亡疾病、懲惡罰罪、使人悔改、此意",
          "bbox": null
        },
        {
          "id": "c03-L06",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "非無足據、昔保羅曰、且以一人在世有罪、",
          "bbox": null
        },
        {
          "id": "c03-L07",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "因罪而死、又曰、罪惡之償値、亡死、蓋禍難",
          "bbox": null
        },
        {
          "id": "c03-L08",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "由於罪惡、然罪惡之報、不徒在於今生、更",
          "bbox": null
        },
        {
          "id": "c03-L09",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "在於世界末日、故見人有禍難、在己貴以",
          "bbox": null
        },
        {
          "id": "c03-L-folio-v020",
          "layer": "original-print",
          "role": "folio",
          "side": "left",
          "text": "一",
          "bbox": null
        }
      ],
