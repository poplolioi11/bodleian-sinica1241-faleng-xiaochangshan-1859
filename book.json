      "source_sha256": "441cbb1103454b55526081f84e0e9b905e4bf2c8139061ceaf1643ce95a1c17f",
      "layout_note": "兩面接續序文，右面九欄、左面七欄；兩個外側版心分別見魚尾和葉碼一、二。天父前的空格及抬敬以版式註記保存，不增添標點。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "reviewed-with-unresolved-readings"
      },
      "units": [
        {
          "id": "c04-R01",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "死亡自省、昔耶穌誨耶路撒冷人曰、爾曹",
          "bbox": null
        },
        {
          "id": "c04-R02",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "不悔改、亦必死亡、可見惡必受罰、當悔改",
          "bbox": null
        },
        {
          "id": "c04-R03",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "求免、況死後永苦、比生前重罰尤慘、勿謂",
          "bbox": null
        },
        {
          "id": "c04-R04",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "天堂地獄之說爲無稽也、近世風俗人心、",
          "bbox": null
        },
        {
          "id": "c04-R05",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "愈降愈下、故兵燹、水旱、瘟疫、疾病、無地無",
          "bbox": null
        },
        {
          "id": "c04-R06",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "之、諸禍中、恒多者惟疾病、顯見者亦惟疾",
          "bbox": null
        },
        {
          "id": "c04-R07",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "病、如貪花柳者有疳疔痳瘋患、飲酒食洋",
          "bbox": null
        },
        {
          "id": "c04-R08",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "烟者、有損身致病患、好勇□狠者、有刀傷",
          "bbox": null
        },
        {
          "id": "c04-R09",
          "layer": "original-print",
          "role": "preface",
          "side": "right",
          "text": "患、此種病患、皆罪所當得、外此百般病患、",
          "bbox": null
        },
        {
          "id": "c04-L01",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "雖良民亦有不免者、推其原皆因初世犯",
          "bbox": null
        },
        {
          "id": "c04-L02",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "罪而起、使初世遵　　天父命、不食禁果、",
          "bbox": null
        },
        {
          "id": "c04-L03",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "便全善無惡、不至貽累後世艱苦也、我輩",
          "bbox": null
        },
        {
          "id": "c04-L04",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "同生覆載內、有時歷水火而得拯救、染疾",
          "bbox": null
        },
        {
          "id": "c04-L05",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "病而得調劑、皆　　天父鴻慈默祐、不忍",
          "bbox": null
        },
        {
          "id": "c04-L06",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "卽罰以死亡、令人悔改、故病者固不可自",
          "bbox": null
        },
        {
          "id": "c04-L07",
          "layer": "original-print",
          "role": "preface",
          "side": "left",
          "text": "誇有福、醫者亦不能自居有功也、",
          "bbox": null
        },
        {
          "id": "c04-R-folio",
          "layer": "original-print",
          "role": "folio",
          "side": "right",
          "text": "一",
          "bbox": null
        },
        {
          "id": "c04-L-folio-v020",
          "layer": "original-print",
          "role": "folio",
          "side": "left",
          "text": "二",
          "bbox": null
        }
      ],
