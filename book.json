    {
      "page_id": "c08",
      "index": 8,
      "width": 2200,
      "height": 2025,
      "official_label": "pp. [12]-[13]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/c8f5b06a-3698-49b3-ad38-c0d552114c15.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/c8f5b06a-3698-49b3-ad38-c0d552114c15/full/2200,/0/default.jpg",
      "source_sha256": "b91189852dc39848695298c7154ae43ffb6921ff31f304f5c67fb2c04e8e1529",
      "layout_note": "右面藥物製法及〈論小腸疝症〉起首，左面續文；配方小註、題名及版心另列。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "complete"
      },
      "units": [
        {
          "id": "c08-u01",
          "layer": "original-print",
          "role": "folio",
          "side": "right",
          "text": "三",
          "bbox": null
        },
        {
          "id": "c08-u02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "十員、封密貯好、雖久可用、",
          "bbox": null
        },
        {
          "id": "c08-u03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "信石酒",
          "bbox": null
        },
        {
          "id": "c08-u04",
          "layer": "original-print",
          "role": "note",
          "side": "right",
          "text": "信石三厘　白者佳",
          "bbox": null
        },
        {
          "id": "c08-u05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "濃酒二錢",
          "bbox": null
        },
        {
          "id": "c08-u06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "滾水一兩四錢",
          "bbox": null
        },
        {
          "id": "c08-u07",
          "layer": "original-print",
          "role": "note",
          "side": "right",
          "text": "共製爲酒功力全補",
          "bbox": null
        },
        {
          "id": "c08-u08",
          "layer": "original-print",
          "role": "title",
          "side": "right",
          "text": "　論小腸疝症",
          "bbox": null
        },
        {
          "id": "c08-u09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "小腸疝、乃小腸離了本位、從肚腹軟弱處",
          "bbox": null
        },
        {
          "id": "c08-u10",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "偪出、或在臍、或在左右大腿與肚腹相連",
          "bbox": null
        },
        {
          "id": "c08-u11",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "處、或在腎囊、但在腎囊者恆多、初起時小、",
          "bbox": null
        },
        {
          "id": "c08-u12",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "愈久愈大、有歷年後、大如人頭者、其故或",
          "bbox": null
        },
        {
          "id": "c08-u13",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "因大力欬嗽、或因大小便出力過多、或因",
          "bbox": null
        },
        {
          "id": "c08-u14",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "提重物所傷、治法不須服藥、病者宜高肩",
          "bbox": null
        },
        {
          "id": "c08-u15",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "捲腿而卧、不使患處緊掣、醫者或以指、或",
          "bbox": null
        },
        {
          "id": "c08-u16",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "以手心送入、外用小腸夾緊壓、長久勿鬆、",
          "bbox": null
        },
        {
          "id": "c08-u17",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "年少者一年後不再發、不須更夾、倘常夾",
          "bbox": null
        },
        {
          "id": "c08-u18",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "或嫌疲苦、或有微痛、用藥酒擦、臨夜睡時",
          "bbox": null
        },
        {
          "id": "c08-u19",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "鬆下、此夾、朝來夾番、纔起因起立、不夾、恐",
          "bbox": null
        },
        {
          "id": "c08-u20",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "小腸復墜、至若小腸有時不能送還本位、",
          "bbox": null
        },
        {
          "id": "c08-u21",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "蓋因筋帶緊勒小腸所出之路、血不通行、",
          "bbox": null
        },
        {
          "id": "c08-u22",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "痛關生死、治法雖是大費工夫、仍須用夾、",
          "bbox": null
        }
      ],
      "uncertainties": [
